{
  "version": 2,
  "initialState": "repository-setup",
  "terminalStates": ["complete", "cancelled", "blocked"],
  "stageSkills": {
    "repository-setup": ["setup-matt-pocock-skills"],
    "grill": ["grill-with-docs", "grilling", "domain-modeling"],
    "specification": ["to-spec"],
    "ticketing": ["to-tickets"],
    "ticket-work": ["implement", "tdd"],
    "ticket-quality": ["tdd", "code-review"],
    "feature-review": ["code-review"]
  },
  "states": [
    "repository-setup",
    "contract",
    "workspace",
    "intake",
    "resume",
    "grill",
    "specification",
    "ticketing",
    "ticket-work",
    "ticket-quality",
    "ticket-commit",
    "feature-review",
    "exception",
    "delivery",
    "delivery-approved",
    "complete",
    "cancelled",
    "blocked"
  ],
  "transitions": [
    {"from": "repository-setup", "event": "setup-configured", "to": "contract", "gate": null, "automatic": true},
    {"from": "contract", "event": "contract-established", "to": "workspace", "gate": null, "automatic": true},
    {"from": "workspace", "event": "reuse-clean-workspace", "to": "intake", "gate": null, "automatic": true},
    {"from": "workspace", "event": "approve-workspace-change", "to": "intake", "gate": "workspace", "automatic": false},
    {"from": "intake", "event": "start-new-feature", "to": "grill", "gate": "invocation", "automatic": true},
    {"from": "intake", "event": "resume-artifact", "to": "resume", "gate": null, "automatic": true},
    {"from": "resume", "event": "approve-resumed-specification", "to": "ticketing", "gate": "resume", "automatic": false},
    {"from": "resume", "event": "approve-resumed-tickets", "to": "ticket-work", "gate": "resume", "automatic": false},
    {"from": "resume", "event": "revise-artifact", "to": "specification", "gate": null, "automatic": false},
    {"from": "grill", "event": "decisions-settled", "to": "specification", "gate": null, "automatic": true},
    {"from": "specification", "event": "approve-and-publish-specification", "to": "ticketing", "gate": "specification", "automatic": false},
    {"from": "ticketing", "event": "approve-and-publish-tickets", "to": "ticket-work", "gate": "ticket-breakdown", "automatic": false},
    {"from": "ticket-work", "event": "workers-joined", "to": "ticket-quality", "gate": null, "automatic": true},
    {"from": "ticket-quality", "event": "owned-findings", "to": "ticket-work", "gate": null, "automatic": true},
    {"from": "ticket-quality", "event": "ticket-quality-passed", "to": "ticket-commit", "gate": null, "automatic": true},
    {"from": "ticket-commit", "event": "ticket-committed-more-ready", "to": "ticket-work", "gate": null, "automatic": true},
    {"from": "ticket-commit", "event": "ticket-committed-all-done", "to": "feature-review", "gate": null, "automatic": true},
    {"from": "feature-review", "event": "owned-findings", "to": "ticket-work", "gate": null, "automatic": true},
    {"from": "feature-review", "event": "feature-review-passed", "to": "delivery", "gate": null, "automatic": true},
    {"from": "delivery", "event": "approve-delivery", "to": "delivery-approved", "gate": "delivery", "automatic": false},
    {"from": "delivery-approved", "event": "delivery-succeeded", "to": "complete", "gate": "delivery-operations-succeeded", "automatic": true},
    {"from": "exception", "event": "decision-received", "to": "$resume", "gate": "exception", "automatic": false}
  ],
  "interruptions": {
    "from": [
      "repository-setup",
      "contract",
      "workspace",
      "intake",
      "resume",
      "grill",
      "specification",
      "ticketing",
      "ticket-work",
      "ticket-quality",
      "ticket-commit",
      "feature-review",
      "delivery",
      "delivery-approved"
    ],
    "to": "exception",
    "when": "new-consequential-decision-risk-conflict-missing-capability-or-stall"
  },
  "termination": {
    "from": "any-nonterminal-state",
    "events": ["cancel", "genuine-blocker"],
    "to": ["cancelled", "blocked"]
  },
  "authorities": [
    {"id": "invocation", "kind": "invocation-directive"},
    {"id": "feature-request", "kind": "invocation-scope"},
    {"id": "setup-confirmation", "kind": "human-gate"},
    {"id": "bootstrap-workspace", "kind": "human-gate"},
    {"id": "contract-persistence", "kind": "human-gate"},
    {"id": "workspace", "kind": "human-gate"},
    {"id": "workspace-established", "kind": "state-evidence"},
    {"id": "specification", "kind": "human-gate"},
    {"id": "ticket-breakdown", "kind": "human-gate"},
    {"id": "resume", "kind": "human-gate"},
    {"id": "ticket-quality-passed", "kind": "state-evidence"},
    {"id": "exception", "kind": "human-gate"},
    {"id": "delivery", "kind": "human-gate"},
    {"id": "push-succeeded", "kind": "state-evidence"},
    {"id": "pull-request-created", "kind": "state-evidence"},
    {"id": "delivery-operations-succeeded", "kind": "composite", "requires": ["push-succeeded", "pull-request-created"]},
    {"id": "contract-bootstrap-authority", "kind": "composite", "requires": ["bootstrap-workspace", "contract-persistence"]},
    {"id": "feature-request-and-workspace", "kind": "composite", "requires": ["feature-request", "workspace-established"]},
    {"id": "approved-work-scope", "kind": "alternative", "requires": ["ticket-breakdown", "resume"]},
    {"id": "ticket-commit-authority", "kind": "composite", "requires": ["approved-work-scope", "ticket-quality-passed"]}
  ],
  "externalOperations": [
    {"operation": "persist-setup-configuration", "state": "repository-setup", "authorizedBy": "setup-confirmation"},
    {"operation": "persist-project-contract", "state": "contract", "authorizedBy": "contract-bootstrap-authority"},
    {"operation": "create-or-switch-feature-branch", "state": "workspace", "authorizedBy": "workspace"},
    {"operation": "create-or-switch-feature-worktree", "state": "workspace", "authorizedBy": "workspace"},
    {"operation": "configure-checkpoint-ignore", "state": "workspace", "authorizedBy": "workspace"},
    {"operation": "write-run-checkpoint", "states": ["intake", "resume", "grill", "specification", "ticketing", "ticket-work", "ticket-quality", "ticket-commit", "feature-review", "exception", "delivery", "delivery-approved"], "authorizedBy": "feature-request-and-workspace"},
    {"operation": "write-project-knowledge", "state": "grill", "authorizedBy": "feature-request-and-workspace"},
    {"operation": "create-parent-specification-issue", "state": "specification", "authorizedBy": "specification"},
    {"operation": "create-ticket-sub-issues", "state": "ticketing", "authorizedBy": "ticket-breakdown"},
    {"operation": "write-repository", "state": "ticket-work", "authorizedBy": "approved-work-scope"},
    {"operation": "stage-ticket", "state": "ticket-commit", "authorizedBy": "ticket-commit-authority"},
    {"operation": "commit-ticket", "state": "ticket-commit", "authorizedBy": "ticket-commit-authority"},
    {"operation": "push-feature-branch", "state": "delivery-approved", "authorizedBy": "delivery"},
    {"operation": "create-pull-request", "state": "delivery-approved", "authorizedBy": "delivery"}
  ],
  "qualityPolicy": {
    "topLevelWorkers": ["implementation", "quality"],
    "dispatch": "concurrent-before-await",
    "overlapFallback": "quality-patch-or-test-design-only",
    "reviewMutation": "read-only",
    "findingRoutes": {
      "production": "implementation",
      "test-or-coverage": "quality",
      "specification-or-architecture": "exception"
    },
    "reviewLoop": {
      "newEvidence": "continue",
      "sameBlockerWithoutNewEvidence": "exception"
    }
  },
  "interactionPolicy": {
    "workflowReply": {
      "requiredFields": ["stage", "progress", "pendingDecisionOrBlocker", "nextStep"],
      "nameActiveGate": true,
      "reportActualStateBeforeTransition": true
    },
    "grill": {
      "maxConsequentialQuestionsPerReply": 1,
      "showQuestionNumber": true,
      "showPrerequisite": true,
      "showKnownQueuedDecisions": true,
      "recomputeAfterEachAnswer": true,
      "includeDomainModelingQuestions": true
    }
  }
}
